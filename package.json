{
  "name": "canvas-table",
  "version": "1.0.0",
  "description": "High-performance Canvas-based table component for large data rendering",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "main": "dist/canvas-table.umd.cjs",
  "module": "dist/canvas-table.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/canvas-table.js",
      "require": "./dist/canvas-table.umd.cjs"
    },
    "./jsx": {
      "types": "./dist/src/core/jsx/index.d.ts",
      "import": "./dist/canvas-table.js",
      "require": "./dist/canvas-table.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json && cp dist/canvas-table.umd.cjs docs/",
    "build:lib": "vite build",
    "build:types": "tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "format": "oxfmt src",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:visual": "playwright test tests/e2e/visual.spec.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,js}": [
      "oxlint --fix",
      "oxfmt --write"
    ]
  },
  "keywords": [
    "canvas",
    "table",
    "datagrid",
    "virtual-scroll",
    "performance"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@playwright/test": "^1.58.2",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^30.3.0",
    "lint-staged": "^16.3.1",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.3.0",
    "vite": "^7.3.6"
  }
}
